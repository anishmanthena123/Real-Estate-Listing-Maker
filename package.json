{
  "name": "listly-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/workflow.integration.test.ts",
    "test:all": "vitest run",
    "db:generate": "PRISMA_JS_MIGRATIONS=true prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "PRISMA_JS_MIGRATIONS=true prisma generate",
    "db:migrate:sql": "tsx scripts/apply-migrations.ts",
    "test:e2e": "playwright test",
    "db:test:migrate": "tsx scripts/migrate-test.ts",
    "start:production": "tsx scripts/start-production.ts",
    "demo:build": "tsx scripts/build-demo.ts",
    "demo:preview": "tsx scripts/serve-demo.ts",
    "demo:test": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
